# Agent 工作区（可选，仅影响 skills/memory/mcp 等文件目录，不决定 config 来源）。
# 配置固定从 src-tauri/resources/config.json 读取。
# SUPPORT_FLOW_WORKSPACE=D:/Desktop/SupportFlow
SUPPORT_FLOW_WORKSPACE=

# 单通道开发（与 pnpm run tauri:dev:wechat 等脚本一致；不设则控制台可自由选择通道）
# NEXT_PUBLIC_DEV_CHANNEL=wx
# DEV_CHANNEL=wx

# 知识库上传：MarkItDown 将文件转为 Markdown 后再切块（需 Python 3.10+）
# pip install -r src-tauri/channel_agent/requirements-markitdown.txt
# CHANNEL_MARKITDOWN_PYTHON=C:\Python312\python.exe

# 通道 sidecar exe（默认 src-tauri/binaries/channel-sidecar-<target>.exe）
# CHANNEL_SIDECAR_EXE=D:/path/to/channel-sidecar.exe
# 开发模式 python -m channel（wework 须 3.8–3.10）。先运行: pnpm run setup:channel-sidecar-dev
# CHANNEL_PYTHON_EXECUTABLE=C:\Users\...\Python38\python.exe
# 打包 sidecar 时用的 Python（默认可自动选 py -3.8）：
# CHANNEL_SIDECAR_PYTHON=C:\Users\...\Python38\python.exe
