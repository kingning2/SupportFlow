{
  "name": "supportflow",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingning2/SupportFlow.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "check:ts:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check:frontend": "pnpm run lint && pnpm run typecheck && pnpm run check:ts:deps && pnpm run check:contracts",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "dev": "turbo run dev --filter=@supportflow/app-wework",
    "build": "turbo run build --filter=@supportflow/app-wework",
    "build:flavor:wework": "node scripts/build-flavor.mjs wework",
    "start": "pnpm --filter @supportflow/app-wework start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "typecheck:apps": "turbo run typecheck",
    "check": "pnpm run format:check && pnpm run check:frontend && pnpm run check:rust:all",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:rust:deps": "cargo machete --with-metadata src-tauri",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check:rust:architecture": "powershell -ExecutionPolicy Bypass -File scripts/check-rust-architecture.ps1",
    "check:rust:all": "pnpm run check:rust:fmt && pnpm run check:rust && pnpm run check:rust:clippy && pnpm run check:rust:deps && pnpm run check:rust:architecture",
    "sf": "cargo run --manifest-path src-tauri/Cargo.toml -p cli --",
    "bootstrap:sidecar-wheels": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/bootstrap-sidecar-wheels.ps1",
    "setup:channel-sidecar-dev": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/build-channel-sidecar.ps1 -DepsOnly",
    "build:channel-sidecar": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/build-channel-sidecar.ps1",
    "build:license-verifier": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/build-license-verifier.ps1",
    "finalize:channel-sidecar": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/finalize-channel-sidecar.ps1",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "pnpm run generate:contracts && git diff --quiet -- packages/shared/src/contracts/contracts.ts",
    "tauri": "tauri",
    "prepare": "husky",
    "tauri:dev": "tauri dev --no-watch",
    "tauri:dev:wework": "node scripts/tauri-dev-channel.mjs wework",
    "tauri:build": "node scripts/tauri-build-flavor.mjs wework",
    "tauri:build:wework": "node scripts/tauri-build-flavor.mjs wework"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
