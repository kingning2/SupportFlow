{
  "name": "SupportFlow",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingning2/SupportFlow.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --filter=@supportflow/app-full",
    "dev:turbo": "turbo run dev:turbo --filter=@supportflow/app-full",
    "build": "turbo run build --filter=@supportflow/app-full",
    "build:flavor:full": "node scripts/build-flavor.mjs full",
    "build:flavor:wework": "node scripts/build-flavor.mjs wework",
    "build:flavor:wechat": "node scripts/build-flavor.mjs wechat",
    "create:channel": "node scripts/create-channel-app.mjs",
    "start": "pnpm --filter @supportflow/app-full start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "typecheck:apps": "turbo run typecheck",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "sf": "cargo run --manifest-path src-tauri/Cargo.toml -p cli --",
    "bootstrap:sidecar-wheels": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/bootstrap-sidecar-wheels.ps1",
    "setup:channel-sidecar-dev": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/build-channel-sidecar.ps1 -DepsOnly",
    "build:channel-sidecar": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/build-channel-sidecar.ps1",
    "finalize:channel-sidecar": "powershell -ExecutionPolicy Bypass -File src-tauri/scripts/finalize-channel-sidecar.ps1",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "pnpm run generate:contracts && git diff --quiet -- packages/shared/src/contracts/contracts.ts",
    "tauri": "tauri",
    "prepare": "husky",
    "tauri:dev": "tauri dev --no-watch",
    "tauri:dev:wechat": "node scripts/tauri-dev-channel.mjs wechat",
    "tauri:dev:weixin": "node scripts/tauri-dev-channel.mjs weixin",
    "tauri:dev:wx": "node scripts/tauri-dev-channel.mjs wx",
    "tauri:dev:feishu": "node scripts/tauri-dev-channel.mjs feishu",
    "tauri:dev:dingtalk": "node scripts/tauri-dev-channel.mjs dingtalk",
    "tauri:dev:wecom": "node scripts/tauri-dev-channel.mjs wecom",
    "tauri:dev:wecom_bot": "node scripts/tauri-dev-channel.mjs wecom_bot",
    "tauri:dev:wework": "node scripts/tauri-dev-channel.mjs wework",
    "tauri:build": "node scripts/tauri-build-flavor.mjs full",
    "tauri:build:wework": "node scripts/tauri-build-flavor.mjs wework",
    "tauri:build:wechat": "node scripts/tauri-build-flavor.mjs wechat",
    "tauri:dev:qq": "node scripts/tauri-dev-channel.mjs qq",
    "tauri:dev:wechatcom": "node scripts/tauri-dev-channel.mjs wechatcom",
    "tauri:dev:wechatmp": "node scripts/tauri-dev-channel.mjs wechatmp"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
