{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupportFlow 微信",
  "build": {
    "beforeDevCommand": "pnpm --filter @supportflow/app-wechat dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm run build:flavor:wechat",
    "frontendDist": "../apps/wechat/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SupportFlow · 微信个人号",
        "width": 1200,
        "height": 800
      }
    ]
  }
}
