{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupportFlow 企微",
  "build": {
    "beforeDevCommand": "pnpm --filter @supportflow/app-wework dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm run build:flavor:wework",
    "frontendDist": "../apps/wework/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SupportFlow · 企微个人号",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "resizable": false
      }
    ]
  }
}
